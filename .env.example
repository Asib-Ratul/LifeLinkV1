# Optional Supabase configuration for future backend integration.
# The current application runs as a browser-local fictional demo without these values.
# Copy to .env.local only when connecting a Supabase project with the hardened migrations.

NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
